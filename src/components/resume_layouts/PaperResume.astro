---
import classNames from "classnames";

import ResumeSection from "src/components/ResumeSection/ResumeSection.astro";

import paper_styles from "./PaperResume.module.scss";
import common_styles from "./resume-common.module.scss";
---

<div
  class:list={classNames(common_styles["resume"], paper_styles["paper-resume"])}
>
  <div class:list={classNames(paper_styles["page"])} id="page-1">
    <div class:list={classNames(paper_styles["fcol"])}>
      <div
        class:list={classNames(paper_styles["frow"], paper_styles["header"])}
      >
        <ResumeSection
          className={classNames(
            paper_styles["fcol"],
            paper_styles["fcol__1-half"],
            common_styles["header-content"]
          )}
          resume_section_id="main_header"
        />
        <div
          class:list={classNames(
            paper_styles["fcol"],
            paper_styles["fcol__1-half"],
            paper_styles["header-brief"]
          )}
        >
          <ResumeSection enterFrom="top" resume_section_id="brief" />
        </div>
      </div>
      <div
        class:list={classNames(paper_styles["frow"])}
        style={{ flexGrow: 1 }}
      >
        <div
          class:list={classNames(
            paper_styles["fcol"],
            paper_styles["fcol__3-4th"]
          )}
        >
          <ResumeSection enterFrom="left" resume_section_id="resume_page_1" />
        </div>
        <div
          class:list={classNames(
            paper_styles["fcol"],
            paper_styles["fcol__1-4th"],
            paper_styles["sidebar"]
          )}
        >
          <ResumeSection enterFrom="bottom" resume_section_id="education" />
          <ResumeSection enterFrom="bottom" resume_section_id="certs" />
          {
            ["languages", "libraries"].map(resume_section_id => (
              <ResumeSection
                className={classNames(common_styles["horizontal-list"])}
                enterFrom="bottom"
                resume_section_id={resume_section_id}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
  <div class:list={classNames(paper_styles["page"])} id="page-2">
    <div class:list={classNames(paper_styles["fcol"])}>
      <div
        class:list={classNames(paper_styles["frow"])}
        style={{ flexGrow: 1 }}
      >
        <div
          class:list={classNames(
            paper_styles["fcol"],
            paper_styles["fcol__3-4th"]
          )}
        >
          <ResumeSection enterFrom="left" resume_section_id="resume_page_2" />
        </div>
        <div
          class:list={classNames(
            paper_styles["fcol"],
            paper_styles["fcol__1-4th"],
            paper_styles["sidebar"]
          )}
        >
          {
            ["tools", "platforms", "skills"].map(resume_section_id => (
              <ResumeSection
                className={classNames(common_styles["horizontal-list"])}
                enterFrom="bottom"
                resume_section_id={resume_section_id}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>
