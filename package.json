{
  "name": "stephen-oneil-resume",
  "version": "3.0.0",
  "homepage": "https://resume.oneil.online",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:debug": "node --inspect-brk node_modules/astro/astro.js build",
    "prelocal-prod": "npm run build && npm run test-pdf-length",
    "local-prod": "http-server dist -c-1 -a 127.0.0.1 -p 3000 -s"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@astrojs/markdoc": "0.15.11",
    "@astrojs/ts-plugin": "1.10.7",
    "@eslint/js": "9.39.1",
